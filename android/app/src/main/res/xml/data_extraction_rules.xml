<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Includes app-private state such as the Capacitor WebView local storage. -->
        <include domain="root" path="." />
        <exclude domain="root" path="cache/" />
        <exclude domain="root" path="code_cache/" />
        <exclude domain="root" path="no_backup/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
        <exclude domain="root" path="cache/" />
        <exclude domain="root" path="code_cache/" />
        <exclude domain="root" path="no_backup/" />
    </device-transfer>
</data-extraction-rules>
